def cmd_tui(_args=None):
    try:
        import curses
    except ImportError:
        pr(C.RED, "  curses not available")
        return 1

    download_dir = _get_download_dir()
    cfg = _load_config()
    current_video = cfg.get("currentVideo", "")
    audio_on = cfg.get("audioEnabled", False)
    audio_vol = int(cfg.get("volume", 0.5) * 100)

    def tui_main(stdscr):
        nonlocal current_video, audio_on, audio_vol
        curses.curs_set(0)
        stdscr.nodelay(False)
        stdscr.keypad(True)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_YELLOW, -1)
        curses.init_pair(5, curses.COLOR_WHITE, -1)
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)

        files = _get_video_files(download_dir)
        selected = 0
        scroll_offset = 0

        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()
            hdr = " Live Wallpaper TUI "
            stdscr.addnstr(0, max(0, (w - len(hdr)) // 2), hdr, w - 1, curses.color_pair(1) | curses.A_BOLD)
            stdscr.addnstr(1, 0, "─" * min(w - 1, 70), w - 1, curses.color_pair(1))
            hint = " ↑↓ Select  Enter Play  a Audio  v Vol  d Dir  r Refresh  q Quit "
            stdscr.addnstr(2, max(0, (w - len(hint)) // 2), hint, w - 2, curses.color_pair(4))

            status = "● Running" if is_daemon_running() else "○ Stopped"
            scolor = curses.color_pair(2) if is_daemon_running() else curses.color_pair(3)
            stdscr.addnstr(3, 2, f"Daemon: {status}", w - 4, scolor)
            audio_str = f"Audio: {'ON' if audio_on else 'OFF'} {audio_vol}%"
            acolor = curses.color_pair(2) if audio_on else curses.color_pair(3)
            stdscr.addnstr(3, 30, audio_str, w - 34, acolor)
            stdscr.addnstr(4, 2, f"Dir: {download_dir}", w - 4, curses.color_pair(4) | curses.A_DIM)

            list_start = 6
            max_items = max(1, h - list_start - 2)

            if not files:
                msg = " No files found "
                msg2 = " Download: wp youtube <url>  |  wp spotify <query> "
                stdscr.addnstr(list_start + 1, max(0, (w - len(msg)) // 2), msg, w - 2, curses.color_pair(4))
                stdscr.addnstr(list_start + 3, max(0, (w - len(msg2)) // 2), msg2, w - 2, curses.color_pair(5))
            else:
                selected = max(0, min(selected, len(files) - 1))
                if selected < scroll_offset:
                    scroll_offset = selected
                elif selected >= scroll_offset + max_items:
                    scroll_offset = selected - max_items + 1
                visible = files[scroll_offset:scroll_offset + max_items]
                for i, f in enumerate(visible):
                    row = list_start + i
                    if row >= h - 2:
                        break
                    idx = scroll_offset + i
                    name = f.name
                    if len(name) > w - 28:
                        name = name[:w - 31] + "..."
                    size = format_size(f.stat().st_size)
                    dur = _file_duration(f)
                    is_current = (current_video == f.name or current_video == str(f))
                    prefix = "▶ " if idx == selected else "  "
                    attr = curses.color_pair(6) | curses.A_BOLD if idx == selected else curses.color_pair(5)
                    tag_str = " (active)" if is_current else ""
                    display = f"{prefix}{name}  {size}  {dur}{tag_str}"
                    if len(display) > w - 4:
                        display = display[:w - 7] + "..."
                    if is_current and idx != selected:
                        attr = curses.color_pair(2)
                    try:
                        stdscr.addnstr(row, 2, display, w - 4, attr)
                    except curses.error:
                        pass

            footer = f" {len(files)} file(s)  |  {download_dir} "
            try:
                stdscr.addnstr(h - 1, 0, "─" * min(w - 1, 70), w - 1, curses.color_pair(1))
                stdscr.addnstr(h - 1, 2, footer[:w - 4], w - 4, curses.color_pair(4))
            except curses.error:
                pass

            stdscr.refresh()
            key = stdscr.getch()

            if key in (ord('q'), ord('Q')):
                return
            elif key == curses.KEY_UP:
                selected = max(0, selected - 1)
            elif key == curses.KEY_DOWN:
                selected = min(len(files) - 1, selected + 1) if files else 0
            elif key in (ord('\n'), 10):
                if files:
                    f = files[selected]
                    if not is_daemon_running():
                        start_daemon()
                    send_command(f"audio {'on' if audio_on else 'off'}")
                    send_command(f"volume {audio_vol}")
                    send_command(f"set {f}")
                    current_video = f.name
            elif key in (ord('a'), ord('A')):
                audio_on = not audio_on
                send_command(f"audio {'on' if audio_on else 'off'}")
            elif key in (ord('v'), ord('V')):
                curses.curs_set(1)
                input_str = str(audio_vol)
                while True:
                    prompt = f" Volume (0-100): {input_str} "
                    try:
                        stdscr.addnstr(h - 2, 2, " " * (w - 4), w - 4, curses.color_pair(4))
                        stdscr.addnstr(h - 2, 2, prompt[:w-4], w - 4, curses.color_pair(4) | curses.A_BOLD)
                        stdscr.refresh()
                    except curses.error:
                        pass
                    k = stdscr.getch()
                    if k in (ord('\n'), 10):
                        try:
                            v = int(input_str)
                            if 0 <= v <= 100:
                                audio_vol = v
                                send_command(f"volume {audio_vol}")
                        except ValueError:
                            pass
                        break
                    elif k == 27:
                        break
                    elif k in (curses.KEY_BACKSPACE, 127, 8):
                        input_str = input_str[:-1]
                    elif 48 <= k <= 57:
                        input_str += chr(k)
                curses.curs_set(0)
            elif key in (ord('d'), ord('D')):
                curses.curs_set(1)
                input_str = str(download_dir)
                while True:
                    prompt = f" Download dir: {input_str}"
                    if len(prompt) > w - 4:
                        prompt = "... " + prompt[-(w - 8):]
                    try:
                        stdscr.addnstr(h - 2, 2, " " * (w - 4), w - 4, curses.color_pair(4))
                        stdscr.addnstr(h - 2, 2, prompt[:w-4], w - 4, curses.color_pair(4) | curses.A_BOLD)
                        stdscr.refresh()
                    except curses.error:
                        pass
                    k = stdscr.getch()
                    if k in (ord('\n'), 10):
                        expanded = os.path.expanduser(input_str)
                        p = Path(expanded)
                        if not p.exists():
                            try:
                                p.mkdir(parents=True, exist_ok=True)
                            except Exception:
                                pass
                        if p.is_dir():
                            download_dir = p
                            files = _get_video_files(download_dir)
                            send_command(f"download-dir {p}")
                        break
                    elif k == 27:
                        break
                    elif k in (curses.KEY_BACKSPACE, 127, 8):
                        input_str = input_str[:-1]
                    elif 32 <= k <= 126:
                        input_str += chr(k)
                curses.curs_set(0)
            elif key in (ord('r'), ord('R')):
                files = _get_video_files(download_dir)

    try:
        curses.wrapper(tui_main)
    except KeyboardInterrupt:
        pass
    return 0

# ── Memory Purge (macOS only) ───────────────────────────────────────────────

PLIST_NAME = "com.xander.purge"
PLIST_SRC = Path(__file__).resolve().parent.parent / "Resources" / f"{PLIST_NAME}.plist"
PLIST_DST = Path.home() / "Library" / "LaunchAgents" / f"{PLIST_NAME}.plist"
PURGE_SCRIPT = "/usr/local/bin/purge-memory"

def _is_purge_loaded():
    if not IS_MACOS:
        return False
    r = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=10)
    return PLIST_NAME in r.stdout

def cmd_memory(args):
    if not IS_MACOS:
        pr(C.YLW, "  Memory purge is only available on macOS")
        return 0

    sub = args[0] if args else "status"
    if sub == "start":
        if not Path(PURGE_SCRIPT).exists():
            if PLIST_SRC.exists():
                try:
                    subprocess.run(["cp", str(PLIST_SRC), str(PLIST_DST)], check=True, timeout=5)
                except subprocess.CalledProcessError:
                    pr(C.RED, "  Failed to copy plist")
                    return 1
            else:
                pr(C.RED, f"  Plist not found: {PLIST_SRC}")
                return 1
        if _is_purge_loaded():
            pr(C.YLW, "  Memory purge is already running")
            return 0
        r = subprocess.run(["launchctl", "load", str(PLIST_DST)], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            pr(C.GRN, "  Memory purge started (every hour)")
        else:
            pr(C.RED, f"  Failed: {r.stderr.strip()}")
            return 1
        return 0
    elif sub == "stop":
        if not _is_purge_loaded():
            pr(C.YLW, "  Memory purge is not running")
            return 0
        subprocess.run(["launchctl", "unload", str(PLIST_DST)], capture_output=True, text=True, timeout=10)
        pr(C.GRN, "  Memory purge stopped")
        return 0
    elif sub == "now":
        pr(C.CYN, "  Purging memory...")
        cfg = _load_config()
        pwd = cfg.get("sudoPassword", "")
        result = subprocess.run(
            ["sudo", "-S", "purge"], input=f"{pwd}\n",
            capture_output=True, text=True, timeout=15
        )
        pr(C.GRN, "  Memory purged") if result.returncode == 0 else pr(C.RED, f"  Failed: {result.stderr.strip()}")
        return 0
    elif sub == "status":
        loaded = _is_purge_loaded()
        pr(C.GRN, "  ● Memory purge is active (every hour)" if loaded else C.YLW + "  ○ Memory purge is stopped")
        return 0
    else:
        pr(C.RED, "  Usage: wp memory <start|stop|now|status>")
        return 1

# ── Main ─────────────────────────────────────────────────────────────────────

COMMANDS = {
    "set": cmd_set, "youtube": cmd_youtube, "yt": cmd_youtube,
    "spotify": cmd_spotify, "sp": cmd_spotify,
    "stop": cmd_stop, "play": cmd_play, "pause": cmd_pause, "restart": cmd_restart,
    "status": cmd_status, "config": cmd_config,
    "audio": cmd_audio, "volume": cmd_volume, "vol": cmd_volume,
    "download-dir": cmd_download_dir, "dir": cmd_download_dir,
    "cache": cmd_cache, "logs": cmd_logs, "doctor": cmd_doctor,
    "update": cmd_update, "check-changes": cmd_check_changes,
    "tui": cmd_tui, "memory": cmd_memory, "mem": cmd_memory,
    "backup": cmd_backup,
    "help": cmd_help, "version": cmd_version,
}

def main():
    if len(sys.argv) < 2:
        cfg = _load_config()
        if cfg.get("autoUpdate", True) and check_internet():
            needs, cur, lat = check_for_update(silent=True)
            if needs:
                pr(C.CYN, f"\n  Update available: v{cur} → v{lat}")
                pr(C.GRY, "  Run: wp update auto\n")
        cmd_help()
        return 0
    cmd = sys.argv[1].lower()
    args = sys.argv[2:]
    if cmd in COMMANDS:
        return COMMANDS[cmd](args)
    else:
        pr(C.RED, f"  Unknown command: {cmd}")
        pr(C.GRY, f"  Run 'wp help' for usage")
        return 1

if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except Exception as e:
        pr(C.RED, f"  Error: {e}")
        sys.exit(1)
