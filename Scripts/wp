#!/usr/bin/env python3

"""
wp — Live Wallpaper CLI/TUI (Cross-Platform)
Controls the livewallpaper daemon on macOS, Windows, and Linux.
"""

import sys
import os
import json
import socket
import subprocess
import time
import shutil
import signal
import re
import platform
import urllib.request
import urllib.error
from pathlib import Path
from typing import Optional, List, Tuple

VERSION = "1.1.0"
REPO_URL = "https://github.com/Xznder1984/WP-Downloader"
GITHUB_API = "https://api.github.com/repos/Xznder1984/WP-Downloader/releases/latest"
GITHUB_RAW = "https://raw.githubusercontent.com/Xznder1984/WP-Downloader/main/VERSION"
GITHUB_FILE_CHECK = "https://api.github.com/repos/Xznder1984/WP-Downloader/contents/Sources"

# ── Platform detection ───────────────────────────────────────────────────────

IS_MACOS = sys.platform == "darwin"
IS_WINDOWS = sys.platform == "win32"
IS_LINUX = sys.platform.startswith("linux")

CONFIG_DIR = Path.home() / ".config" / "livewallpaper" if not IS_WINDOWS else Path.home() / "AppData" / "Local" / "LiveWallpaper"
SOCKET_PATH = CONFIG_DIR / "daemon.sock" if not IS_WINDOWS else CONFIG_DIR / "daemon.pipe"
PID_FILE = CONFIG_DIR / "daemon.pid"
LOG_FILE = CONFIG_DIR / "daemon.log"
DAEMON_BIN = "livewallpaper"
VERSION_FILE = Path(__file__).resolve().parent.parent / "VERSION"

# ── ANSI Colors ──────────────────────────────────────────────────────────────

class C:
    RST = "\033[0m"
    BLD = "\033[1m"
    DIM = "\033[2m"
    RED = "\033[1;31m"
    GRN = "\033[1;32m"
    YLW = "\033[1;33m"
    BLU = "\033[1;34m"
    MAG = "\033[1;35m"
    CYN = "\033[1;36m"
    WHT = "\033[1;37m"
    GRY = "\033[90m"

def pr(color, text, end="\n"):
    sys.stdout.write(f"{color}{text}{C.RST}{end}")
    sys.stdout.flush()

def strip_ansi(s):
    return re.sub(r'\033\[[0-9;]*m', '', s)

def banner():
    pr(C.CYN, f"""
{C.CYN}{C.BLD}    ╔═══════════════════════════════════╗
    ║       {C.WHT}Live Wallpaper{C.CYN} {C.GRY}v{VERSION}{C.CYN}       ║
    ╚═══════════════════════════════════╝{C.RST}
""")

def box(lines, title=""):
    width = max(len(strip_ansi(l)) for l in lines) + 4
    if title:
        width = max(width, len(title) + 4)
    print(f"  {C.CYN}╔{'═' * (width - 2)}╗{C.RST}")
    if title:
        pad = width - 2 - len(title) - 2
        left = pad // 2
        right = pad - left
        print(f"  {C.CYN}║{C.RST}{' ' * left}{C.BLD}{title}{C.RST}{' ' * right}{C.CYN}║{C.RST}")
        print(f"  {C.CYN}╠{'═' * (width - 2)}╣{C.RST}")
    for line in lines:
        vis_len = len(strip_ansi(line))
        padding = width - 2 - vis_len
        if padding < 0:
            padding = 0
        print(f"  {C.CYN}║{C.RST} {line}{' ' * (padding - 1)}{C.CYN}║{C.RST}")
    print(f"  {C.CYN}╚{'═' * (width - 2)}╝{C.RST}")

def spinner(msg, duration=1.5):
    frames = ["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"]
    end_time = time.time() + duration
    i = 0
    while time.time() < end_time:
        sys.stdout.write(f"\r  {C.CYN}{frames[i % len(frames)]}{C.RST}  {msg}  ")
        sys.stdout.flush()
        time.sleep(0.08)
        i += 1
    sys.stdout.write(f"\r  {C.GRN}✓{C.RST}  {msg}        \n")
    sys.stdout.flush()

def format_size(size_bytes):
    if size_bytes >= 1073741824:
        return f"{size_bytes / 1073741824:.1f} GB"
    elif size_bytes >= 1048576:
        return f"{size_bytes / 1048576:.1f} MB"
    elif size_bytes >= 1024:
        return f"{size_bytes / 1024:.1f} KB"
    return f"{size_bytes} B"

# ── Internet + Update checker ────────────────────────────────────────────────

def check_internet(timeout=5) -> bool:
    try:
        urllib.request.urlopen("https://1.1.1.1", timeout=timeout)
        return True
    except Exception:
        try:
            urllib.request.urlopen("https://8.8.8.8", timeout=timeout)
            return True
        except Exception:
            return False

def get_local_version() -> str:
    if VERSION_FILE.exists():
        return VERSION_FILE.read_text().strip()
    return VERSION

def check_for_update(silent=False) -> Tuple[bool, str, str]:
    """Check GitHub for newer version. Returns (needs_update, current, latest)."""
    current = get_local_version()
    try:
        req = urllib.request.Request(GITHUB_RAW, headers={"User-Agent": f"wp/{current}"})
        resp = urllib.request.urlopen(req, timeout=5)
        latest = resp.read().decode("utf-8").strip()
        if latest and latest != current:
            return (True, current, latest)
        return (False, current, latest or current)
    except Exception:
        return (False, current, current)

def check_for_file_changes() -> List[str]:
    """Check if local source files differ from GitHub versions."""
    changes = []
    try:
        req = urllib.request.Request(GITHUB_API, headers={"User-Agent": f"wp/{VERSION}"})
        resp = urllib.request.urlopen(req, timeout=10)
        import base64
        files = json.loads(resp.read().decode("utf-8"))
        local_sources = Path(__file__).resolve().parent.parent / "Sources"
        if not local_sources.exists():
            return changes
        for item in files:
            name = item.get("name", "")
            if name.endswith(".swift") or name.endswith(".py"):
                try:
                    raw_url = item.get("download_url", "")
                    if raw_url:
                        r = urllib.request.urlopen(raw_url, timeout=5)
                        remote_content = r.read().decode("utf-8")
                        local_file = local_sources / name
                        if local_file.exists():
                            local_content = local_file.read_text()
                            if remote_content != local_content:
                                changes.append(name)
                except Exception:
                    pass
    except Exception:
        pass
    return changes

def cmd_update(args):
    """Check for updates and optionally update."""
    pr(C.CYN, "\n  Checking for updates...\n")

    if not check_internet():
        pr(C.RED, "  No internet connection")
        pr(C.GRY, "  Connect to the internet and try again")
        return 1

    needs_update, current, latest = check_for_update()

    if needs_update:
        pr(C.GRN, f"  Update available: {C.WHT}{current}{C.GRN} → {C.WHT}{latest}{C.RST}")
        pr(C.GRY, f"  Download: {REPO_URL}")
        print()

        if args and args[0] == "auto":
            pr(C.CYN, "  Auto-updating...")
            install_dir = Path(__file__).resolve().parent.parent
            try:
                subprocess.run(
                    ["git", "-C", str(install_dir), "pull", "--rebase"],
                    capture_output=True, text=True, timeout=30
                )
                # Re-run installer
                install_py = install_dir / "install.py"
                if install_py.exists():
                    subprocess.run([sys.executable, str(install_py), "--upgrade"], timeout=120)
                    pr(C.GRN, f"  Updated to v{latest}")
                else:
                    pr(C.YLW, "  Git updated but install.py not found")
            except Exception as e:
                pr(C.RED, f"  Auto-update failed: {e}")
                pr(C.GRY, f"  Manual update: git pull && python3 install.py --upgrade")
                return 1
        else:
            pr(C.GRY, "  Run: wp update auto")
            pr(C.GRY, "  Or manually: git pull && python3 install.py --upgrade")
    else:
        pr(C.GRN, f"  Already up to date (v{current})")

    return 0

def cmd_check_changes(_args=None):
    """Check if local files differ from GitHub."""
    pr(C.CYN, "\n  Checking local files against GitHub...\n")

    if not check_internet():
        pr(C.RED, "  No internet connection")
        return 1

    spinner("Comparing files")
    changes = check_for_file_changes()

    if changes:
        pr(C.YLW, f"\n  {len(changes)} file(s) differ from GitHub:")
        for c in changes:
            pr(C.WHT, f"    • {c}")
        pr(C.GRY, f"\n  Run: wp update auto  (to sync)")
    else:
        pr(C.GRN, "  All local files match GitHub")

    return 0

# ── Config helpers ───────────────────────────────────────────────────────────

def _load_config():
    cfg = CONFIG_DIR / "config.json"
    if cfg.exists():
        try:
            return json.loads(cfg.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    return {}

def _get_download_dir():
    cfg = _load_config()
    d = cfg.get("downloadDir", str(CONFIG_DIR / "cache"))
    Path(d).mkdir(parents=True, exist_ok=True)
    return Path(d)

# ── IPC ──────────────────────────────────────────────────────────────────────

def send_command(command: str, timeout: float = 10.0) -> Optional[dict]:
    if IS_WINDOWS:
        # Windows: use named pipe
        pipe_path = f"\\\\.\\pipe\\livewallpaper"
        try:
            import win32file
            import win32pipe
            handle = win32file.CreateFile(
                pipe_path, win32file.GENERIC_READ | win32file.GENERIC_WRITE,
                0, None, win32file.OPEN_EXISTING, 0, None
            )
            payload = json.dumps({"command": command}).encode("utf-8")
            win32file.WriteFile(handle, payload)
            win32file.CloseHandle(handle)
            return None
        except Exception:
            return None
    else:
        if not SOCKET_PATH.exists():
            return None
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect(str(SOCKET_PATH))
            payload = json.dumps({"command": command}).encode("utf-8")
            sock.sendall(payload)
            sock.shutdown(socket.SHUT_WR)
            chunks = []
            while True:
                try:
                    data = sock.recv(4096)
                    if not data:
                        break
                    chunks.append(data)
                except socket.timeout:
                    break
            sock.close()
            response = b"".join(chunks).decode("utf-8")
            return json.loads(response)
        except (ConnectionRefusedError, FileNotFoundError, OSError, json.JSONDecodeError):
            return None

def is_daemon_running() -> bool:
    if not PID_FILE.exists():
        return False
    try:
        pid = int(PID_FILE.read_text().strip())
        if IS_WINDOWS:
            r = subprocess.run(["tasklist", "/FI", f"PID eq {pid}"], capture_output=True, text=True)
            return str(pid) in r.stdout
        else:
            os.kill(pid, 0)
            return True
    except (ValueError, ProcessLookupError, PermissionError):
        return False

def get_pid() -> Optional[int]:
    if not PID_FILE.exists():
        return None
    try:
        return int(PID_FILE.read_text().strip())
    except ValueError:
        return None

def start_daemon():
    if is_daemon_running():
        return True
    try:
        if IS_WINDOWS:
            subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve().parent.parent / "Sources" / "engine_win.py")],
                creationflags=subprocess.DETACHED_PROCESS,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        elif IS_LINUX:
            subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve().parent.parent / "Sources" / "engine_linux.py")],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True
            )
        else:
            subprocess.Popen(
                [DAEMON_BIN],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True
            )
    except FileNotFoundError:
        pr(C.RED, f"  Daemon binary not found. Run: python3 install.py")
        return False
    for _ in range(30):
        time.sleep(0.1)
        if SOCKET_PATH.exists() or PID_FILE.exists():
            break
    pr(C.GRN, "  Daemon started")
    return True

# ── TUI File Picker ──────────────────────────────────────────────────────────

def _get_video_files(directory: Path) -> List[Path]:
    exts = {".mp4", ".mkv", ".webm", ".mov", ".avi", ".m4v", ".flv", ".ogg", ".mp3", ".m4a", ".wav", ".flac"}
    files = []
    if directory.exists():
        for f in directory.iterdir():
            if f.is_file() and f.suffix.lower() in exts:
                files.append(f)
    files.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    return files

def _file_duration(path: Path) -> str:
    try:
        r = subprocess.run(
            ["ffprobe", "-v", "quiet", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0 and r.stdout.strip():
            secs = float(r.stdout.strip())
            m, s = divmod(int(secs), 60)
            h, m = divmod(m, 60)
            return f"{h}:{m:02d}:{s:02d}" if h > 0 else f"{m}:{s:02d}"
    except Exception:
        pass
    return "—"

def tui_file_picker(title: str = "Select Video") -> Optional[Path]:
    try:
        import curses
    except ImportError:
        pr(C.RED, "  curses not available")
        return None

    download_dir = _get_download_dir()
    files = _get_video_files(download_dir)
    cfg = _load_config()
    current_video = cfg.get("currentVideo", "")

    def picker_main(stdscr):
        nonlocal files
        curses.curs_set(0)
        stdscr.nodelay(False)
        stdscr.keypad(True)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_YELLOW, -1)
        curses.init_pair(5, curses.COLOR_WHITE, -1)
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)

        selected = 0
        scroll_offset = 0
        audio_on = cfg.get("audioEnabled", False)
        audio_vol = int(cfg.get("volume", 0.5) * 100)

        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()
            hdr = f" {title} "
            stdscr.addnstr(0, max(0, (w - len(hdr)) // 2), hdr, w - 1, curses.color_pair(1) | curses.A_BOLD)
            stdscr.addnstr(1, 0, "─" * min(w - 1, 70), w - 1, curses.color_pair(1))
            stdscr.addnstr(2, 0, f"  Dir: {download_dir}"[:w-2], w - 2, curses.color_pair(4) | curses.A_DIM)
            audio_str = f"  Audio: {'ON' if audio_on else 'OFF'}  Vol: {audio_vol}%"
            stdscr.addnstr(3, 0, audio_str[:w-2], w - 2, curses.color_pair(2) if audio_on else curses.color_pair(3))
            hint = " ↑↓ Select  Enter Play  a Audio  v Volume  d Dir  r Refresh  q Cancel "
            stdscr.addnstr(4, max(0, (w - len(hint)) // 2), hint, w - 2, curses.color_pair(4))

            list_start = 6
            max_items = max(1, h - list_start - 3)

            if not files:
                msg = " No files found in download directory "
                msg2 = f" Download: wp youtube <url>  |  wp spotify <query> "
                stdscr.addnstr(list_start + 1, max(0, (w - len(msg)) // 2), msg, w - 2, curses.color_pair(4))
                stdscr.addnstr(list_start + 3, max(0, (w - len(msg2)) // 2), msg2, w - 2, curses.color_pair(5))
            else:
                selected = max(0, min(selected, len(files) - 1))
                if selected < scroll_offset:
                    scroll_offset = selected
                elif selected >= scroll_offset + max_items:
                    scroll_offset = selected - max_items + 1
                visible = files[scroll_offset:scroll_offset + max_items]
                for i, f in enumerate(visible):
                    row = list_start + i
                    if row >= h - 3:
                        break
                    idx = scroll_offset + i
                    name = f.name
                    if len(name) > w - 28:
                        name = name[:w - 31] + "..."
                    size = format_size(f.stat().st_size)
                    dur = _file_duration(f)
                    is_current = (current_video == f.name or current_video == str(f))
                    prefix = "▶ " if idx == selected else "  "
                    attr = curses.color_pair(6) | curses.A_BOLD if idx == selected else curses.color_pair(5)
                    tag_str = " (active)" if is_current else ""
                    display = f"{prefix}{name}  {size}  {dur}{tag_str}"
                    if len(display) > w - 4:
                        display = display[:w - 7] + "..."
                    if is_current and idx != selected:
                        attr = curses.color_pair(2)
                    try:
                        stdscr.addnstr(row, 2, display, w - 4, attr)
                    except curses.error:
                        pass
                if len(files) > max_items:
                    bar_h = max(1, max_items)
                    bar_pos = int((selected / max(1, len(files) - 1)) * (bar_h - 1))
                    for i in range(bar_h):
                        ch = "█" if i == bar_pos else "│"
                        r = list_start + i
                        if r < h - 3:
                            try:
                                stdscr.addnstr(r, w - 2, ch, 1, curses.color_pair(1))
                            except curses.error:
                                pass

            footer = f" {len(files)} file(s)  |  {download_dir} "
            try:
                stdscr.addnstr(h - 1, 0, "─" * min(w - 1, 70), w - 1, curses.color_pair(1))
                stdscr.addnstr(h - 1, 2, footer[:w - 4], w - 4, curses.color_pair(4))
            except curses.error:
                pass

            stdscr.refresh()
            key = stdscr.getch()

            if key in (ord('q'), ord('Q')):
                return None
            elif key == curses.KEY_UP:
                selected = max(0, selected - 1)
            elif key == curses.KEY_DOWN:
                selected = min(len(files) - 1, selected + 1) if files else 0
            elif key in (ord('\n'), 10):
                if files:
                    return files[selected]
            elif key in (ord('a'), ord('A')):
                audio_on = not audio_on
            elif key in (ord('v'), ord('V')):
                curses.curs_set(1)
                input_str = str(audio_vol)
                while True:
                    prompt = f" Volume (0-100): {input_str} "
                    try:
                        stdscr.addnstr(h - 2, 2, " " * (w - 4), w - 4, curses.color_pair(4))
                        stdscr.addnstr(h - 2, 2, prompt[:w-4], w - 4, curses.color_pair(4) | curses.A_BOLD)
                        stdscr.refresh()
                    except curses.error:
                        pass
                    k = stdscr.getch()
                    if k in (ord('\n'), 10):
                        try:
                            v = int(input_str)
                            if 0 <= v <= 100:
                                audio_vol = v
                        except ValueError:
                            pass
                        break
                    elif k == 27:
                        break
                    elif k in (curses.KEY_BACKSPACE, 127, 8):
                        input_str = input_str[:-1]
                    elif 48 <= k <= 57:
                        input_str += chr(k)
                curses.curs_set(0)
            elif key in (ord('d'), ord('D')):
                curses.curs_set(1)
                input_str = str(download_dir)
                while True:
                    prompt = f" Download dir: {input_str}"
                    if len(prompt) > w - 4:
                        prompt = "... " + prompt[-(w - 8):]
                    try:
                        stdscr.addnstr(h - 2, 2, " " * (w - 4), w - 4, curses.color_pair(4))
                        stdscr.addnstr(h - 2, 2, prompt[:w-4], w - 4, curses.color_pair(4) | curses.A_BOLD)
                        stdscr.refresh()
                    except curses.error:
                        pass
                    k = stdscr.getch()
                    if k in (ord('\n'), 10):
                        expanded = os.path.expanduser(input_str)
                        p = Path(expanded)
                        if not p.exists():
                            try:
                                p.mkdir(parents=True, exist_ok=True)
                            except Exception:
                                pass
                        if p.is_dir():
                            download_dir = p
                            files = _get_video_files(download_dir)
                            send_command(f"download-dir {p}")
                        break
                    elif k == 27:
                        break
                    elif k in (curses.KEY_BACKSPACE, 127, 8):
                        input_str = input_str[:-1]
                    elif 32 <= k <= 126:
                        input_str += chr(k)
                curses.curs_set(0)
            elif key in (ord('r'), ord('R')):
                files = _get_video_files(download_dir)

    try:
        return curses.wrapper(picker_main)
    except KeyboardInterrupt:
        return None

def tui_audio_prompt() -> Tuple[bool, int]:
    cfg = _load_config()
    audio_on = cfg.get("audioEnabled", False)
    audio_vol = int(cfg.get("volume", 0.5) * 100)
    confirmed = [False]

    try:
        import curses
    except ImportError:
        return audio_on, audio_vol

    def audio_main(stdscr):
        nonlocal audio_on, audio_vol
        curses.curs_set(0)
        stdscr.nodelay(False)
        stdscr.keypad(True)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_YELLOW, -1)
        curses.init_pair(5, curses.COLOR_WHITE, -1)
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)

        selected = 0
        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()
            hdr = " Audio Settings "
            stdscr.addnstr(0, max(0, (w - len(hdr)) // 2), hdr, w - 1, curses.color_pair(1) | curses.A_BOLD)
            stdscr.addnstr(1, 0, "─" * min(w - 1, 50), w - 1, curses.color_pair(1))

            y = 3
            audio_str = f"  Audio:  [{'ON ' if audio_on else 'OFF'}]"
            color = curses.color_pair(2) if audio_on else curses.color_pair(3)
            prefix = "▶ " if selected == 0 else "  "
            stdscr.addnstr(y, 2, prefix + audio_str[2:], w - 4, color | (curses.A_BOLD if selected == 0 else 0))
            y += 2

            vol_str = f"  Volume: {audio_vol:3d}%  [{'█' * (audio_vol // 5)}{'░' * (20 - audio_vol // 5)}]"
            prefix = "▶ " if selected == 1 else "  "
            stdscr.addnstr(y, 2, prefix + vol_str[2:], w - 4, curses.color_pair(4) | (curses.A_BOLD if selected == 1 else 0))
            y += 3

            ok_attr = curses.color_pair(6) | curses.A_BOLD if selected == 2 else curses.color_pair(2)
            cancel_attr = curses.color_pair(6) | curses.A_BOLD if selected == 3 else curses.color_pair(3)
            stdscr.addnstr(y, 5, "[OK]", 4, ok_attr)
            stdscr.addnstr(y, 15, "[Cancel]", 8, cancel_attr)

            hint = " Tab/Arrows Navigate  Space/Enter Toggle  q Cancel "
            stdscr.addnstr(y + 2, max(0, (w - len(hint)) // 2), hint, w - 2, curses.color_pair(4) | curses.A_DIM)
            stdscr.refresh()
            key = stdscr.getch()

            if key in (ord('q'), ord('Q')):
                return
            elif key in (ord('\t'), curses.KEY_DOWN):
                selected = (selected + 1) % 4
            elif key in (27, curses.KEY_UP):
                selected = (selected - 1) % 4
            elif key in (ord(' '), 10):
                if selected == 0:
                    audio_on = not audio_on
                elif selected == 2:
                    confirmed[0] = True
                    return
                elif selected == 3:
                    return
            elif selected == 1:
                if key in (curses.KEY_RIGHT, ord('+')):
                    audio_vol = min(100, audio_vol + 5)
                elif key in (curses.KEY_LEFT, ord('-')):
                    audio_vol = max(0, audio_vol - 5)

    try:
        curses.wrapper(audio_main)
    except KeyboardInterrupt:
        pass

    if not confirmed[0]:
        return cfg.get("audioEnabled", False), int(cfg.get("volume", 0.5) * 100)
    return audio_on, audio_vol

# ── Commands ─────────────────────────────────────────────────────────────────

def cmd_set(args):
    pr(C.CYN, "\n  Select a video file:\n")
    selected = tui_file_picker(title="Select Video")
    if selected is None:
        pr(C.YLW, "  Cancelled")
        return 0

    pr(C.CYN, "\n  Configure audio:\n")
    audio_on, audio_vol = tui_audio_prompt()

    if not start_daemon():
        return 1

    send_command(f"audio {'on' if audio_on else 'off'}")
    send_command(f"volume {audio_vol}")

    spinner("Setting wallpaper")
    result = send_command(f"set {selected}")
    if result is None:
        pr(C.RED, "  Failed to communicate with daemon")
        return 1
    if "error" in result:
        pr(C.RED, f"  {result['error']}")
        return 1

    pr(C.GRN, f"  Wallpaper set: {C.BLD}{selected.name}{C.RST}")
    pr(C.GRY, f"  Audio: {'ON' if audio_on else 'OFF'}  Volume: {audio_vol}%")
    return 0

def _detect_url_type(url):
    lower = url.lower()
    if "spotify.com" in lower or "spotify:" in lower:
        return "spotify"
    if any(x in lower for x in ["youtube.com", "youtu.be", "yt-dlp", "y2u.be", "youtube-nocookie.com"]):
        return "youtube"
    if any(x in lower for x in ["/watch", "/shorts/", "/playlist?", "/channel/", "/c/", "/user/"]):
        return "youtube"
    if any(x in lower for x in [".mp4", ".mkv", ".webm", ".mov", ".avi", ".m4v"]):
        return "video"
    return None

def cmd_youtube(args):
    if not args:
        pr(C.RED, "  Usage: wp youtube <url>")
        pr(C.GRY, "  Supports: single videos, playlists, channels")
        return 1

    url = args[0]
    url_type = _detect_url_type(url)
    if url_type == "spotify":
        pr(C.YLW, "  Detected Spotify URL, switching to wp spotify...")
        return cmd_spotify(args)
    if url_type == "video":
        pr(C.YLW, "  Detected local file, switching to wp set...")
        return cmd_set(args)
    if not shutil.which("yt-dlp"):
        pr(C.RED, "  yt-dlp not found. Install: brew install yt-dlp (macOS) / winget install yt-dlp (Windows) / sudo apt install yt-dlp (Linux)")
        return 1

    is_playlist = any(x in url.lower() for x in ["playlist?", "/playlist", "/channel/", "/c/", "/user/", "/@"])
    if "--playlist" in args:
        is_playlist = True
    if "--no-playlist" in args:
        is_playlist = False

    download_dir = _get_download_dir()
    download_dir.mkdir(parents=True, exist_ok=True)

    if is_playlist:
        pr(C.CYN, f"\n  Downloading playlist: {C.WHT}{url}{C.RST}\n")
        cmd = [
            "yt-dlp",
            "-f", "bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best",
            "--merge-output-format", "mp4",
            "-o", str(download_dir / "%(playlist_index)s - %(title)s.%(ext)s"),
            "--yes-playlist", "--newline",
            "--sleep-interval", "3",
            "--max-sleep-interval", "8",
            "--retries", "3",
            "--retry-sleep", "5",
            url
        ]
    else:
        pr(C.CYN, f"\n  Downloading: {C.WHT}{url}{C.RST}\n")
        cmd = [
            "yt-dlp",
            "-f", "bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best",
            "--merge-output-format", "mp4",
            "-o", str(download_dir / "%(title)s.%(ext)s"),
            "--no-playlist", "--newline", url
        ]

    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        current_idx = ""
        for line in proc.stdout:
            line = line.strip()
            if "[download]" in line and "%" in line:
                for p in line.split():
                    if "%" in p:
                        sys.stdout.write(f"\r  {C.CYN}⬇{C.RST}  {p}  ")
                        sys.stdout.flush()
                        break
            elif "[download] Downloading item" in line:
                current_idx = line.split()[-1].rstrip(":")
                pr(C.CYN, f"\n  [{current_idx}] ", end="")
            elif "Merger" in line:
                spinner("Merging formats")
        proc.wait()
        print()
        if proc.returncode != 0:
            pr(C.RED, "  Download failed")
            return 1
    except FileNotFoundError:
        pr(C.RED, "  yt-dlp not found")
        return 1
    except KeyboardInterrupt:
        print()
        pr(C.YLW, "  Download cancelled")
        return 130

    mp4s = sorted(download_dir.glob("*.mp4"), key=lambda f: f.stat().st_mtime, reverse=True)
    if not mp4s:
        mp4s = sorted(
            [f for f in download_dir.iterdir() if f.is_file() and f.suffix in (".mkv", ".webm", ".mp4")],
            key=lambda f: f.stat().st_mtime, reverse=True
        )
    if not mp4s:
        pr(C.RED, "  Could not find downloaded file")
        return 1

    if is_playlist and len(mp4s) > 1:
        pr(C.GRN, f"\n  Downloaded {len(mp4s)} videos from playlist")
        pr(C.GRY, f"  Files in: {download_dir}")
        downloaded = tui_file_picker(title="Select Video from Playlist")
        if downloaded is None:
            pr(C.YLW, "  Cancelled")
            return 0
    else:
        downloaded = mp4s[0]
        pr(C.GRN, f"\n  Downloaded: {C.BLD}{downloaded.name}{C.RST}")

    pr(C.CYN, "\n  Configure audio:\n")
    audio_on, audio_vol = tui_audio_prompt()

    if not start_daemon():
        return 1
    send_command(f"audio {'on' if audio_on else 'off'}")
    send_command(f"volume {audio_vol}")

    spinner("Setting wallpaper")
    result = send_command(f"set {downloaded}")
    if result and "error" not in result:
        pr(C.GRN, f"  Wallpaper set!")
        pr(C.GRY, f"  Audio: {'ON' if audio_on else 'OFF'}  Volume: {audio_vol}%")
    else:
        pr(C.RED, f"  Failed to set wallpaper")
        return 1
    return 0

def cmd_spotify(args):
    if not args:
        pr(C.RED, "  Usage: wp spotify <url-or-query>")
        pr(C.GRY, "  Examples:")
        pr(C.GRY, "    wp spotify https://open.spotify.com/track/...")
        pr(C.GRY, "    wp spotify https://open.spotify.com/playlist/...")
        pr(C.GRY, "    wp spotify 'lofi hip hop beats'")
        return 1

    query = " ".join(args)
    url_type = _detect_url_type(query)
    if url_type == "youtube":
        pr(C.YLW, "  Detected YouTube URL, switching to wp youtube...")
        return cmd_youtube(args)
    if url_type == "video":
        pr(C.YLW, "  Detected local file, switching to wp set...")
        return cmd_set(args)
    if not shutil.which("spotdl"):
        pr(C.RED, "  spotdl not found. Install: pip3 install spotdl")
        return 1
    if not shutil.which("ffmpeg"):
        pr(C.RED, "  ffmpeg not found. Install: brew install ffmpeg / winget install ffmpeg / sudo apt install ffmpeg")
        return 1

    is_playlist = "playlist" in query.lower() or "album" in query.lower()

    download_dir = _get_download_dir()
    download_dir.mkdir(parents=True, exist_ok=True)
    pr(C.CYN, f"\n  Downloading from Spotify: {C.WHT}{query}{C.RST}\n")

    cmd = ["spotdl", "download", query, "--output", str(download_dir), "--format", "mp3"]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        count = 0
        for line in proc.stdout:
            line = line.strip()
            if "Downloading" in line or "downloaded" in line.lower():
                count += 1
                sys.stdout.write(f"\r  {C.CYN}♫{C.RST}  [{count}] {line[:60]}  ")
                sys.stdout.flush()
        proc.wait()
        print()
        if proc.returncode != 0:
            pr(C.RED, "  Download failed")
            return 1
    except FileNotFoundError:
        pr(C.RED, "  spotdl not found")
        return 1
    except KeyboardInterrupt:
        print()
        pr(C.YLW, "  Download cancelled")
        return 130

    mp3s = sorted(download_dir.glob("*.mp3"), key=lambda f: f.stat().st_mtime, reverse=True)
    if not mp3s:
        pr(C.RED, "  No audio file found")
        return 1

    if is_playlist and len(mp3s) > 1:
        pr(C.GRN, f"\n  Downloaded {len(mp3s)} tracks from playlist")
        pr(C.GRY, f"  Files in: {download_dir}")
        downloaded = tui_file_picker(title="Select Track from Playlist")
        if downloaded is None:
            pr(C.YLW, "  Cancelled")
            return 0
    else:
        downloaded = mp3s[0]
        pr(C.GRN, f"\n  Downloaded: {C.BLD}{downloaded.name}{C.RST}")

    video_path = download_dir / (downloaded.stem + "_audio.mp4")
    spinner("Creating audio wallpaper")
    ffmpeg_cmd = [
        "ffmpeg", "-y",
        "-f", "lavfi", "-i", "color=c=black:s=1920x1080:d=60:r=24",
        "-i", str(downloaded), "-shortest",
        "-c:v", "libx264", "-tune", "stillimage",
        "-c:a", "aac", "-b:a", "192k",
        "-pix_fmt", "yuv420p", "-movflags", "+faststart",
        str(video_path)
    ]
    try:
        r = subprocess.run(ffmpeg_cmd, capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            pr(C.YLW, "  ffmpeg wrapper failed, playing audio file directly")
            video_path = downloaded
    except Exception:
        video_path = downloaded

    pr(C.CYN, "\n  Configure audio:\n")
    audio_on, audio_vol = tui_audio_prompt()

    if not start_daemon():
        return 1
    send_command(f"audio {'on' if audio_on else 'off'}")
    send_command(f"volume {audio_vol}")

    spinner("Setting audio wallpaper")
    result = send_command(f"set {video_path}")
    if result and "error" not in result:
        pr(C.GRN, f"  Audio wallpaper set!")
        pr(C.GRY, f"  Audio: {downloaded.name}")
    else:
        pr(C.RED, f"  Failed to set wallpaper")
        return 1
    return 0

def cmd_stop(_args=None):
    if not is_daemon_running():
        pr(C.YLW, "  Daemon is not running")
        return 0
    send_command("stop")
    pr(C.GRN, "  Wallpaper stopped")
    return 0

def cmd_play(_args=None):
    if not is_daemon_running():
        pr(C.RED, "  Daemon not running. Start with: wp set")
        return 1
    result = send_command("play")
    pr(C.GRN, "  Playback resumed") if result and "error" not in result else pr(C.RED, "  Failed")
    return 0

def cmd_pause(_args=None):
    if not is_daemon_running():
        pr(C.RED, "  Daemon not running")
        return 1
    result = send_command("pause")
    pr(C.GRN, "  Playback paused") if result and "error" not in result else pr(C.RED, "  Failed")
    return 0

def cmd_restart(_args=None):
    if not is_daemon_running():
        pr(C.RED, "  Daemon not running")
        return 1
    result = send_command("reload")
    pr(C.GRN, "  Wallpaper restarted") if result and "error" not in result else pr(C.RED, "  Failed")
    return 0

def cmd_status(_args=None):
    result = send_command("status")
    if result is None:
        box([f"  Status:  {C.RED}● Stopped{C.RST}", f"  Daemon:  Not running"], "Live Wallpaper Status")
        return 0
    if "error" in result:
        pr(C.RED, f"  Error: {result['error']}")
        return 1

    running = result.get("running", False)
    sc = C.GRN if running else C.RED
    st = "● Running" if running else "● Stopped"
    video = result.get("current_video", "none")
    if video and video != "none":
        video = Path(video).name

    mem = "—"
    pid = result.get("pid", "—")
    if pid and pid != "unknown":
        try:
            ps_out = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True)
            if ps_out.returncode == 0:
                rss_kb = int(ps_out.stdout.strip())
                mem = f"{rss_kb / 1024:.1f} MB" if rss_kb > 1024 else f"{rss_kb} KB"
        except (ValueError, subprocess.SubprocessError):
            pass

    audio_on = result.get("audio_enabled", False)
    vol = int(result.get("volume", 0) * 100)
    audio_str = f"{'● On' if audio_on else '○ Off'}  {C.GRY}vol {vol}%{C.RST}"

    lines = [
        f"  Status:  {sc}{st}{C.RST}",
        f"  PID:     {C.WHT}{pid}{C.RST}",
        f"  Video:   {C.WHT}{video}{C.RST}",
        f"  Audio:   {C.WHT}{audio_str}",
        f"  Screens: {C.WHT}{result.get('screens', '?')}{C.RST}",
        f"  Dir:     {C.WHT}{result.get('download_dir', '~')}{C.RST}",
        f"  Memory:  {C.WHT}{mem}{C.RST}",
    ]
    box(lines, "Live Wallpaper Status")
    return 0

def cmd_config(args):
    if args and args[0] == "edit":
        config_file = CONFIG_DIR / "config.json"
        if not config_file.exists():
            pr(C.YLW, "  No config found. Creating default...")
            (CONFIG_DIR / "config.json").write_text(json.dumps({
                "enabled": False, "currentVideo": None, "audioEnabled": False,
                "volume": 0.5, "fillMode": "aspectFill", "displayMode": "all",
                "downloadDir": str(CONFIG_DIR / "cache"), "autoUpdate": True
            }, indent=2))
        editor = os.environ.get("EDITOR", os.environ.get("VISUAL", "nano"))
        pr(C.CYN, f"  Opening {editor}...")
        os.system(f'{editor} "{CONFIG_DIR / "config.json"}"')
        pr(C.GRN, "  Config saved. Run: wp restart")
        return 0

    if args and args[0] == "set" and len(args) >= 3:
        key = args[1]
        val_str = " ".join(args[2:])
        cfg = _load_config()
        if val_str.lower() == "true":
            cfg[key] = True
        elif val_str.lower() == "false":
            cfg[key] = False
        else:
            try:
                cfg[key] = int(val_str)
            except ValueError:
                try:
                    cfg[key] = float(val_str)
                except ValueError:
                    cfg[key] = val_str
        (CONFIG_DIR / "config.json").write_text(json.dumps(cfg, indent=2))
        pr(C.GRN, f"  {key} = {cfg[key]}")
        return 0

    if args and args[0] == "reset":
        default = {
            "enabled": False, "currentVideo": None, "audioEnabled": False,
            "volume": 0.5, "fillMode": "aspectFill", "displayMode": "all",
            "downloadDir": str(CONFIG_DIR / "cache"), "autoUpdate": True
        }
        (CONFIG_DIR / "config.json").write_text(json.dumps(default, indent=2))
        pr(C.GRN, "  Config reset to defaults")
        return 0

    if args and len(args) >= 2 and args[0] == "auto-update":
        val = args[1].lower()
        if val not in ("on", "off"):
            pr(C.RED, "  Usage: wp config auto-update on|off")
            return 1
        cfg = _load_config()
        cfg["autoUpdate"] = val == "on"
        (CONFIG_DIR / "config.json").write_text(json.dumps(cfg, indent=2))
        pr(C.GRN, f"  Auto-update: {'ON' if val == 'on' else 'OFF'}")
        return 0

    config_file = CONFIG_DIR / "config.json"
    if not config_file.exists():
        pr(C.YLW, "  No config found.")
        return 0
    try:
        config = json.loads(config_file.read_text())
    except json.JSONDecodeError:
        pr(C.RED, "  Corrupt config file")
        return 1

    video = config.get("currentVideo", "none")
    if video and video != "none":
        video = Path(video).name

    lines = [
        f"  Enabled:       {C.WHT}{config.get('enabled', False)}{C.RST}",
        f"  Video:         {C.WHT}{video}{C.RST}",
        f"  Audio:         {C.WHT}{'On' if config.get('audioEnabled') else 'Off'}{C.RST}",
        f"  Volume:        {C.WHT}{int(config.get('volume', 0.0) * 100)}%{C.RST}",
        f"  Fill Mode:     {C.WHT}{config.get('fillMode', 'aspectFill')}{C.RST}",
        f"  Display Mode:  {C.WHT}{config.get('displayMode', 'all')}{C.RST}",
        f"  Download Dir:  {C.WHT}{config.get('downloadDir', '~/.config/livewallpaper/cache')}{C.RST}",
        f"  Auto-Update:   {C.WHT}{'On' if config.get('autoUpdate', True) else 'Off'}{C.RST}",
    ]
    box(lines, "Configuration")
    pr(C.GRY, f"\n  Config file: {config_file}")
    return 0

def cmd_backup(args):
    config_file = CONFIG_DIR / "config.json"
    backup_file = CONFIG_DIR / "config.backup.json"

    if args and args[0] == "restore":
        if not backup_file.exists():
            pr(C.RED, "  No backup found. Run: wp backup")
            return 1
        try:
            data = json.loads(backup_file.read_text())
            config_file.write_text(json.dumps(data, indent=2))
            pr(C.GRN, "  Config restored from backup")
            pr(C.GRY, "  Run: wp restart")
            return 0
        except Exception as e:
            pr(C.RED, f"  Restore failed: {e}")
            return 1

    if args and args[0] == "diff":
        if not backup_file.exists():
            pr(C.RED, "  No backup found")
            return 1
        try:
            current = json.loads(config_file.read_text())
            backup = json.loads(backup_file.read_text())
            all_keys = sorted(set(list(current.keys()) + list(backup.keys())))
            diffs = []
            for k in all_keys:
                cur_val = current.get(k, "<missing>")
                bak_val = backup.get(k, "<missing>")
                if cur_val != bak_val:
                    diffs.append((k, bak_val, cur_val))
            if not diffs:
                pr(C.GRN, "  No differences — backup matches current config")
            else:
                pr(C.CYN, "\n  Backup → Current differences:")
                for k, old, new in diffs:
                    pr(C.WHT, f"    {k}:")
                    pr(C.RED, f"      - {old}")
                    pr(C.GRN, f"      + {new}")
            return 0
        except Exception as e:
            pr(C.RED, f"  Error: {e}")
            return 1

    if not config_file.exists():
        pr(C.RED, "  No config to backup")
        return 1
    try:
        data = json.loads(config_file.read_text())
        backup_file.write_text(json.dumps(data, indent=2))
        pr(C.GRN, f"  Backup saved: {backup_file}")
        pr(C.GRY, "  Restore: wp backup restore  |  Compare: wp backup diff")
        return 0
    except Exception as e:
        pr(C.RED, f"  Backup failed: {e}")
        return 1

def cmd_download_dir(args):
    if not args:
        cfg = _load_config()
        d = cfg.get("downloadDir", str(CONFIG_DIR / "cache"))
        pr(C.WHT, f"  Download directory: {C.CYN}{d}{C.RST}")
        files = _get_video_files(Path(d))
        total = sum(f.stat().st_size for f in files)
        pr(C.GRY, f"  {len(files)} file(s), {format_size(total)}")
        return 0

    path = Path(os.path.expanduser(args[0])).resolve()
    if not path.exists():
        try:
            path.mkdir(parents=True, exist_ok=True)
            pr(C.GRN, f"  Created: {path}")
        except Exception as e:
            pr(C.RED, f"  Cannot create directory: {e}")
            return 1
    if not path.is_dir():
        pr(C.RED, f"  Not a directory: {path}")
        return 1

    result = send_command(f"download-dir {path}")
    if result and "error" not in result:
        pr(C.GRN, f"  Download directory set to: {path}")
    else:
        cfg = _load_config()
        cfg["downloadDir"] = str(path)
        (CONFIG_DIR / "config.json").write_text(json.dumps(cfg, indent=2))
        pr(C.GRN, f"  Download directory set to: {path}")
    return 0

def cmd_cache(args):
    download_dir = _get_download_dir()
    if args and args[0] == "clear":
        files = list(download_dir.iterdir())
        if not files:
            pr(C.GRY, "  Cache is already empty")
            return 0
        total = sum(f.stat().st_size for f in files if f.is_file())
        for f in files:
            if f.is_file():
                f.unlink()
        pr(C.GRN, f"  Cache cleared ({format_size(total)} freed)")
        return 0
    if args and args[0] == "size":
        files = [f for f in download_dir.iterdir() if f.is_file()]
        total = sum(f.stat().st_size for f in files)
        pr(C.WHT, f"  Cache size: {format_size(total)}")
        pr(C.GRY, f"  {len(files)} file(s) in {download_dir}")
        return 0

    files = sorted([f for f in download_dir.iterdir() if f.is_file()], key=lambda f: f.stat().st_mtime, reverse=True)
    if not files:
        pr(C.GRY, f"  Cache is empty ({download_dir})")
        return 0
    pr(C.CYN, f"\n  Cached files ({len(files)}) in {download_dir}:")
    for f in files:
        pr(C.WHT, f"    {f.name}  {C.GRY}({format_size(f.stat().st_size)}){C.RST}")
    pr(C.GRY, f"\n  Total: {format_size(sum(f.stat().st_size for f in files))}")
    return 0

def cmd_logs(_args=None):
    if not LOG_FILE.exists():
        pr(C.GRY, "  No logs available")
        return 0
    content = LOG_FILE.read_text()
    lines = content.strip().split("\n")
    for line in lines[-30:]:
        pr(C.GRY, f"  {line}")
    return 0

def cmd_doctor(_args=None):
    pr(C.CYN, f"\n  {C.BLD}System Diagnostics{C.RST}\n")
    checks = []

    # Internet
    internet = check_internet()
    checks.append(("Internet", internet, "Connected" if internet else "No connection"))

    # OS
    os_name = platform.system()
    os_ver = platform.version()
    checks.append(("OS", True, f"{os_name} {os_ver} ({platform.machine()})"))

    # Python
    checks.append(("Python", True, platform.python_version()))

    # Swift (macOS only)
    if IS_MACOS:
        try:
            r = subprocess.run(["swiftc", "--version"], capture_output=True, text=True, timeout=10)
            ver = r.stdout.strip().split("\n")[0] if r.returncode == 0 else "not found"
            checks.append(("Swift compiler", r.returncode == 0, ver))
        except Exception:
            checks.append(("Swift compiler", False, "not found"))

    # yt-dlp
    try:
        r = subprocess.run(["yt-dlp", "--version"], capture_output=True, text=True, timeout=10)
        checks.append(("yt-dlp", r.returncode == 0, r.stdout.strip()[:30]))
    except Exception:
        checks.append(("yt-dlp", False, "not found"))

    # ffmpeg
    try:
        r = subprocess.run(["ffmpeg", "-version"], capture_output=True, text=True, timeout=10)
        ver = r.stdout.strip().split("\n")[0][:50] if r.returncode == 0 else "error"
        checks.append(("ffmpeg", r.returncode == 0, ver))
    except Exception:
        checks.append(("ffmpeg", False, "not found"))

    # mpv (Linux/Windows)
    if not IS_MACOS:
        has_mpv = shutil.which("mpv") is not None
        checks.append(("mpv (video)", has_mpv, shutil.which("mpv") or "not found"))

    # Daemon
    running = is_daemon_running()
    pid = get_pid()
    checks.append(("Daemon", running, f"PID {pid}" if running else "not running"))
    checks.append(("Config dir", CONFIG_DIR.exists(), str(CONFIG_DIR)))

    if not IS_WINDOWS:
        checks.append(("Socket", SOCKET_PATH.exists(), str(SOCKET_PATH)))

    download_dir = _get_download_dir()
    checks.append(("Download dir", download_dir.exists(), str(download_dir)))

    has_bin = shutil.which(DAEMON_BIN) is not None or (Path(__file__).resolve().parent.parent / "Sources").exists()
    checks.append(("livewallpaper", has_bin, shutil.which(DAEMON_BIN) or "available (build with install.py)"))

    # spotdl
    has_spotdl = shutil.which("spotdl") is not None
    spotdl_ver = ""
    if has_spotdl:
        try:
            r = subprocess.run(["spotdl", "--version"], capture_output=True, text=True, timeout=10)
            spotdl_ver = r.stdout.strip()[:30] if r.returncode == 0 else "installed"
        except Exception:
            spotdl_ver = "installed"
    checks.append(("spotdl (Spotify)", has_spotdl, spotdl_ver or "not found (pip3 install spotdl)"))

    # Update check (if internet)
    if internet:
        needs_update, current, latest = check_for_update(silent=True)
        if needs_update:
            checks.append(("Update", False, f"v{current} → v{latest} available"))
        else:
            checks.append(("Update", True, f"v{current} (latest)"))

    for name, ok, detail in checks:
        icon = f"{C.GRN}✓{C.RST}" if ok else f"{C.RED}✗{C.RST}"
        detail_color = C.GRY if ok else C.RED
        pr(C.WHT, f"    {icon}  {name:<20} {detail_color}{detail}{C.RST}")

    passed = sum(1 for _, ok, _ in checks if ok)
    total = len(checks)
    if passed == total:
        pr(C.GRN, f"\n  All {total} checks passed")
    else:
        pr(C.YLW, f"\n  {passed}/{total} checks passed")
    return 0 if passed == total else 1

def cmd_version(_args=None):
    pr(C.WHT, f"  wp v{VERSION}")
    pr(C.GRY, f"  Live Wallpaper for macOS / Windows / Linux")
    pr(C.GRY, f"  © 2026 Xander Development")
    pr(C.GRY, f"  {REPO_URL}")
    return 0

